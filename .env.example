# Drive&Shine Command Center - Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database
DATABASE_URL=your_database_url_here

# Payment Provider (for future integration)
PAYMENT_PROVIDER_KEY=your_payment_provider_key_here

# AI API (for future features)
AI_API_KEY=your_ai_api_key_here

# Storage
STORAGE_BUCKET=driveshine-uploads

# Application
APPLICATION_URL=http://localhost:5173
